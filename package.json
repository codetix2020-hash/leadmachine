{
	"name": "supastarter-nextjs",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --concurrency 15",
		"type-check": "dotenv -c -- turbo type-check",
		"start": "dotenv -c -- turbo start",
		"lint": "biome lint . ",
		"check": "biome check",
		"clean": "turbo clean",
		"format": "biome format . --write",
		"db:setup": "tsx scripts/setup-database.ts",
		"db:reset": "tsx scripts/reset-database.ts",
		"db:migrate": "tsx scripts/run-migration-direct.ts"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.14.0",
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^25.5.0",
		"@types/pg": "^8.16.0",
		"cross-env": "^10.1.0",
		"dotenv": "^17.3.1",
		"dotenv-cli": "^11.0.0",
		"pg": "^8.16.3",
		"tsx": "^4.21.0",
		"turbo": "^2.8.20",
		"typescript": "6.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@swc/core",
			"prisma",
			"prisma-zod-generator",
			"sharp"
		]
	},
	"dependencies": {
		"node-fetch": "^3.3.2"
	}
}
